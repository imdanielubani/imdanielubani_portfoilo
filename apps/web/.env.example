# Public site URL (used for canonical URLs, sitemap and Open Graph)
SITE_URL=http://localhost:3001

# NestJS API base URL (server-side). Leave empty until the API is running.
API_URL=
# Same API, reachable from the browser (used by the contact form).
NEXT_PUBLIC_API_URL=

# When API_URL is empty, serve the bundled seed content instead of failing.
# Set to "off" in production once the API is live.
CONTENT_FALLBACK=seed

# Shared secret the API uses to call POST /api/revalidate after publishing.
REVALIDATE_SECRET=change-me

# Seconds between background revalidation of public content.
CONTENT_REVALIDATE_SECONDS=300

# Optional. A GitHub token (no scopes needed) lets the contribution graph use
# GitHub's official GraphQL API. Without it, a public read-only mirror is used.
GITHUB_TOKEN=
